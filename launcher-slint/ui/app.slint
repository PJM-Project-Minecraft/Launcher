import { ComboBox } from "std-widgets.slint";
import "../assets/minecraft-Regular.ttf";
import "../assets/minecraft-Bold.ttf";
import "../assets/minecraft-ten.ttf";

// Pixelarticons состоят из целочисленных 2px-блоков. Запрещаем
// линейную фильтрацию, чтобы они не размывались при масштабировании.
component PixelIcon inherits Image {
    image-fit: contain;
    image-rendering: pixelated;
}

// Своё поле ввода не наследует голубой Fluent focus-indicator.
component PjmLineEdit inherits Rectangle {
    in-out property <string> text;
    in property <InputType> input-type: InputType.text;
    in property <bool> enabled: true;
    in property <length> font-size: 16px;
    callback accepted(string);

    public function request-focus() { field.focus(); }

    border-radius: 4px;
    background: root.enabled ? #161a1f : #11151a;
    border-color: field.has-focus ? #ffb020 : #9eaab82e;
    border-width: field.has-focus ? 2px : 1px;
    opacity: root.enabled ? 1.0 : 0.58;
    animate background, border-color, border-width, opacity {
        duration: 160ms;
        easing: ease-out-quint;
    }

    field := TextInput {
        x: 12px;
        y: 2px;
        width: parent.width - 24px;
        height: parent.height - 4px;
        text <=> root.text;
        input-type: root.input-type;
        enabled: root.enabled;
        single-line: true;
        font-family: "Minecraft Default";
        font-size: root.font-size;
        font-weight: 400;
        color: #f2ece0;
        vertical-alignment: center;
        selection-background-color: #ffb020;
        selection-foreground-color: #0b0f14;
        text-cursor-width: 2px;
        accepted => { root.accepted(self.text); }
    }
}

component GoldButton inherits Rectangle {
    in property <string> label;
    in property <image> icon-source;
    in property <bool> enabled: true;
    callback clicked();

    height: 56px;
    border-radius: 4px;
    background: !enabled ? #43464b : (ta.pressed ? #d89418 : (ta.has-hover ? #ffc14d : #ffb020));
    border-color: ta.has-hover && enabled ? #ffe1a0 : #ffb02078;
    border-width: 1px;
    opacity: enabled ? 1.0 : 0.62;
    animate background { duration: 180ms; easing: ease-out-quint; }
    animate border-color { duration: 180ms; easing: ease-out-quint; }
    animate opacity { duration: 180ms; easing: ease-out-quint; }
    horizontal-stretch: 0;

    drop-shadow-blur: enabled ? (ta.has-hover ? 24px : 16px) : 6px;
    drop-shadow-color: enabled ? (ta.has-hover ? #ffb02066 : #ffb0203d) : #00000000;
    drop-shadow-offset-y: enabled ? (ta.has-hover ? 10px : 6px) : 2px;
    animate drop-shadow-blur { duration: 300ms; easing: ease-out-quint; }
    animate drop-shadow-offset-y { duration: 320ms; easing: ease-out-quint; }

    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        spacing: 10px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 14px;
                background: #26292e;

            PixelIcon {
                source: root.icon-source;
                width: 20px;
                height: 20px;
                x: 4px;
                y: 4px;
                colorize: #f2f4f6;
            }
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                font-family: "Minecraft Default";
                color: #0b0f14;
                font-size: 16px;
                font-weight: 900;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component DarkButton inherits Rectangle {
    in property <string> label;
    in property <image> icon-source;
    // transparent = без перекраски (иконка в исходных цветах).
    in property <brush> icon-color: transparent;
    in property <bool> enabled: true;
    in property <LayoutAlignment> content-alignment: center;
    callback clicked();

    height: 52px;
    border-radius: 4px;
    background: !enabled ? #11151a : (ta.pressed ? #303944 : (ta.has-hover ? #273340 : #090c10));
    opacity: enabled ? 1.0 : 0.58;
    animate background { duration: 180ms; easing: ease-out-quint; }
    animate opacity { duration: 180ms; easing: ease-out-quint; }
    horizontal-stretch: 0;
    border-color: ta.has-hover && enabled ? #ffb02078 : #9eaab821;
    border-width: 1px;
    animate border-color { duration: 180ms; easing: ease-out-quint; }
    drop-shadow-blur: ta.has-hover && enabled ? 14px : 8px;
    drop-shadow-color: ta.has-hover && enabled ? #000000bb : #00000088;
    drop-shadow-offset-y: ta.has-hover && enabled ? 7px : 4px;
    animate drop-shadow-blur { duration: 300ms; easing: ease-out-quint; }
    animate drop-shadow-offset-y { duration: 320ms; easing: ease-out-quint; }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        spacing: 10px;
        alignment: root.content-alignment;

        VerticalLayout {
            alignment: center;

            Rectangle {
                width: 28px;
                height: 28px;
                PixelIcon {
                    source: root.icon-source;
                    width: 24px;
                    height: 24px;
                    x: 2px;
                    y: 2px;
                    colorize: root.icon-color;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                color: ta.has-hover && root.enabled ? #f2ece0 : #c7cdd6;
                animate color { duration: 180ms; easing: ease-out-quint; }
                font-size: 14px;
                font-weight: 900;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component NavButton inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <image> icon-source;
    callback clicked();

    width: 140px;
    height: 72px;
    background: transparent;

    if root.icon-source.width > 0: PixelIcon {
        source: root.icon-source;
        x: 0px;
        y: 20px;
        width: 32px;
        height: 32px;
        colorize: root.active ? #ffb020 : (ta.has-hover ? #f2ece0 : #9aa4b0);
        animate colorize { duration: 180ms; easing: ease-out-quint; }
    }

    Text {
        text: root.label;
        x: 42px;
        y: 0px;
        width: parent.width - 42px;
        height: parent.height - 3px;
        font-family: "Minecraft Default";
        color: root.active ? #ffb020 : (ta.has-hover ? #f2ece0 : #c7cdd6);
        animate color { duration: 180ms; easing: ease-out-quint; }
        font-size: 19px;
        font-weight: 700;
        vertical-alignment: center;
        overflow: elide;
    }

    Rectangle {
        y: parent.height - 3px;
        width: parent.width;
        height: 3px;
        background: #ffb020;
        opacity: root.active ? 1.0 : 0.0;
        animate opacity { duration: 120ms; easing: ease-out-quad; }
    }

    ta := TouchArea { clicked => { root.clicked(); } }
}

// Для соцсетей используем официальные плавные знаки, а не
// условные пиктограммы из общего UI-набора.
component SocialButton inherits Rectangle {
    in property <image> icon-source;
    in property <brush> brand-color;
    callback clicked();

    width: 52px;
    height: 52px;
    border-radius: 4px;
    background: social-touch.pressed ? root.brand-color : (social-touch.has-hover ? #273340 : #090c10);
    border-color: social-touch.has-hover ? root.brand-color : #9eaab821;
    border-width: 1px;
    animate background, border-color { duration: 180ms; easing: ease-out-quint; }

    Image {
        source: root.icon-source;
        image-fit: contain;
        image-rendering: smooth;
        x: 11px;
        y: 11px;
        width: 30px;
        height: 30px;
        colorize: social-touch.pressed ? #ffffff : root.brand-color;
        animate colorize { duration: 180ms; easing: ease-out-quint; }
    }

    social-touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component IconButton inherits Rectangle {
    in property <image> icon-source;
    in property <brush> icon-color: #c7cdd6;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    callback clicked();

    width: 48px;
    height: 48px;
    border-radius: 4px;
    background: !enabled ? #11151a : (icon-touch.pressed
        ? (danger ? #421717 : #303944)
        : (icon-touch.has-hover ? (danger ? #321416 : #273340) : #090c10));
    border-color: icon-touch.has-hover && enabled
        ? (danger ? #ff6b6b88 : #ffb02078)
        : #9eaab821;
    border-width: 1px;
    opacity: enabled ? 1.0 : 0.46;
    animate background, border-color, opacity { duration: 180ms; easing: ease-out-quint; }

    PixelIcon {
        source: root.icon-source;
        x: 12px;
        y: 12px;
        width: 24px;
        height: 24px;
        colorize: root.danger ? #ff6b6b : root.icon-color;
    }

    icon-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component PlayButton inherits Rectangle {
    in property <string> label;
    in property <image> icon-source;
    in property <bool> enabled: true;
    callback clicked();

    height: 64px;
    border-radius: 4px;
    background: !enabled ? #3a3d42 : (ta.pressed ? #d89418 : (ta.has-hover ? #ffc14d : #ffb020));
    opacity: enabled ? 1.0 : 0.62;
    animate background { duration: 180ms; easing: ease-out-quint; }
    animate opacity { duration: 180ms; easing: ease-out-quint; }
    border-color: ta.has-hover && enabled ? #ffe1a0 : #ffb02078;
    border-width: 1px;
    animate border-color { duration: 180ms; easing: ease-out-quint; }

    drop-shadow-blur: ta.has-hover ? 22px : 14px;
    drop-shadow-color: enabled ? (ta.has-hover ? #ffb02066 : #ffb0203d) : #00000000;
    drop-shadow-offset-y: ta.has-hover ? 10px : 6px;
    animate drop-shadow-blur { duration: 300ms; easing: ease-out-quint; }
    animate drop-shadow-offset-y { duration: 320ms; easing: ease-out-quint; }

    HorizontalLayout {
        padding-left: 22px;
        padding-right: 28px;
        spacing: 16px;
        alignment: center;

        VerticalLayout {
            alignment: center;
            Rectangle {
                width: 48px;
                height: 48px;
                border-radius: 24px;
                background: enabled ? #26292e : #ffffff1f;

                PixelIcon {
                    source: root.icon-source;
                    width: 32px;
                    height: 32px;
                    x: 8px;
                    y: 8px;
                    colorize: enabled ? #f2f4f6 : #ffffff;
                }
            }
        }

        VerticalLayout {
            alignment: center;
            Text {
                text: root.label;
                font-family: "Minecraft Default";
                color: enabled ? #0b0f14 : #ffffff;
                font-size: 22px;
                font-weight: 900;
                letter-spacing: 0px;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component MiniButton inherits Rectangle {
    in property <string> label;
    in property <bool> active: false;
    in property <bool> enabled: true;
    callback clicked();

    width: 58px;
    height: 52px;
    border-radius: 4px;
    background: !enabled ? #11151a : (active ? #ffb020 : (ta.pressed ? #34301f : (ta.has-hover ? #222a32 : #090c10)));
    border-color: active ? #ffc14d : (ta.has-hover ? #ffb02078 : #9eaab821);
    border-width: 1px;
    opacity: enabled ? 1.0 : 0.56;
    animate background { duration: 180ms; easing: ease-out-quint; }
    animate border-color { duration: 180ms; easing: ease-out-quint; }
    animate opacity { duration: 180ms; easing: ease-out-quint; }

    Text {
        text: root.label;
        color: active ? #0b0f14 : #f2ece0;
        font-size: 18px;
        font-weight: 900;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    ta := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

// Компактный переключатель настроек. Текстовое состояние остаётся читаемым
// без опоры только на цвет, а общий контракт скрывает повторяющуюся анимацию.
component SettingsToggle inherits Rectangle {
    in property <bool> checked;
    in property <bool> enabled: true;
    callback toggled(bool);

    width: 72px;
    height: 30px;
    border-radius: 4px;
    background: !enabled ? #14191f : (checked ? (toggle-touch.has-hover ? #ffc14d : #ffb020) : (toggle-touch.has-hover ? #273340 : #19212b));
    border-color: checked ? #ffc14d : (toggle-touch.has-hover ? #9eaab847 : #9eaab821);
    border-width: 1px;
    opacity: enabled ? 1.0 : 0.48;
    animate background, border-color, opacity { duration: 180ms; easing: ease-out-quint; }

    Text {
        text: root.checked ? "ВКЛ" : "ВЫКЛ";
        color: root.checked ? #0b0f14 : #9aa4b0;
        animate color { duration: 180ms; easing: ease-out-quint; }
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 0.7px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    toggle-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.checked); }
    }
}

// Маленькая action-кнопка для плотных строк настроек. В отличие от DarkButton
// она не резервирует место под иконку и визуально совпадает с WEB control rows.
component SettingsButton inherits Rectangle {
    in property <string> label;
    in property <bool> primary: false;
    in property <bool> enabled: true;
    callback clicked();

    height: 40px;
    border-radius: 4px;
    background: !enabled ? #11151a : (primary
        ? (settings-button-touch.pressed ? #d89418 : (settings-button-touch.has-hover ? #ffc14d : #ffb020))
        : (settings-button-touch.pressed ? #303944 : (settings-button-touch.has-hover ? #273340 : #19212b)));
    border-color: primary ? #ffc14d : (settings-button-touch.has-hover ? #ffb02078 : #9eaab821);
    border-width: 1px;
    opacity: enabled ? 1.0 : 0.48;
    animate background, border-color, opacity { duration: 180ms; easing: ease-out-quint; }

    Text {
        text: root.label;
        color: root.primary ? #0b0f14 : #c7cdd6;
        animate color { duration: 180ms; easing: ease-out-quint; }
        font-size: 11px;
        font-weight: 900;
        letter-spacing: 0.7px;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }

    settings-button-touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

struct NewsItem {
    title: string,
    date: string,
    body: string,
}

component NewsCard inherits Rectangle {
    in property <string> title;
    in property <string> date;
    in property <string> body;
    in property <int> index;

    // Каскадное появление: каждая карточка проявляется с задержкой по индексу.
    property <bool> shown: false;
    init => { shown = true; }

    height: 116px;
    border-radius: 6px;
    background: ta.has-hover ? #273340d9 : #0e1319eb;
    border-color: ta.has-hover ? #ffb02078 : #9eaab821;
    border-width: 1px;
    clip: true;
    opacity: shown ? 1.0 : 0.0;
    drop-shadow-blur: ta.has-hover ? 16px : 0px;
    drop-shadow-color: #00000066;
    drop-shadow-offset-y: ta.has-hover ? 6px : 0px;
    animate background, border-color { duration: 220ms; easing: ease-out-quint; }
    animate drop-shadow-blur { duration: 300ms; easing: ease-out-quint; }
    animate drop-shadow-offset-y { duration: 300ms; easing: ease-out-quint; }
    animate opacity { duration: 380ms; delay: index * 70ms; easing: ease-out-quint; }

    Rectangle {
        x: 0px;
        y: 0px;
        width: ta.has-hover ? 6px : 4px;
        height: parent.height;
        background: #ffb020;
        animate width { duration: 220ms; easing: ease-out-quint; }
    }

    VerticalLayout {
        x: 22px;
        y: root.shown ? 16px : 30px;
        width: parent.width - 44px;
        height: parent.height - 32px;
        spacing: 8px;
        animate y { duration: 420ms; delay: root.index * 70ms; easing: ease-out-quint; }

        HorizontalLayout {
            spacing: 12px;
            Text {
                text: root.title;
                color: #eceef1;
                font-size: 16px;
                font-weight: 800;
                overflow: elide;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: root.date;
                color: #989ca2;
                font-size: 13px;
                font-weight: 700;
                vertical-alignment: center;
            }
        }

        Text {
            text: root.body;
            color: #bbbec3;
            font-size: 13px;
            font-weight: 600;
            wrap: word-wrap;
            overflow: elide;
        }
    }

    ta := TouchArea {}
}

export component AppWindow inherits Window {
    title: "Project Minecraft Launcher";
    preferred-width: 1200px;
    preferred-height: 750px;
    // 232px сайдбар + 728px плей-карточка при синке + отступы: уже 900px даёт наложение.
    min-width: 1024px;
    min-height: 600px;
    background: #090c10;
    default-font-family: "Minecraft Default";
    default-font-weight: 400;

    property <float> startup-opacity: 0.0;
    in-out property <int> active-tab: 0;
    
    init => {
        startup-opacity = 1.0;
    }

    changed settings-visible => {
        if (self.settings-visible) { settings-esc.focus(); }
    }

    in property <string> api-url;
    // Серверы бэкенда: нулевой пункт — «Авто» (лаунчер сам берёт самый быстрый),
    // дальше зеркала. Селектор скрыт, если зеркало одно — выбирать не из чего.
    in property <[string]> server-names;
    in-out property <int> server-index;
    in property <bool> server-visible;
    in property <string> message;
    in property <string> user-login;
    in property <string> user-uuid;
    in property <string> token-expires-at;
    in-out property <string> login-value;
    in-out property <string> password-value;
    in-out property <string> totp-value;
    in property <bool> requires-totp;
    in property <bool> is-loading;
    in property <bool> is-authenticated;
    in property <bool> is-slim;
    in property <bool> is-syncing;
    in property <bool> has-profile;
    in property <bool> profile-installed;
    in property <bool> profile-update-available;
    in property <bool> profile-state-checking;
    in property <bool> profile-state-unknown;
    in property <bool> download-panel-visible;
    in property <string> selected-profile-name;
    in property <string> selected-profile-version;
    in property <string> profile-status;
    in property <string> playtime-total;
    in property <string> download-phase;
    in property <string> download-file;
    in property <string> download-counter;
    in property <float> download-progress;
    in-out property <bool> settings-visible;
    in property <int> memory-gb;
    // Максимум слайдера = физическое ОЗУ машины (выставляется из Rust).
    in property <int> memory-max: 64;
    in property <bool> memory-auto;
    in property <string> memory-label;
    // Дискретная видеокарта (гибридная графика). Секция видна только когда
    // discrete-gpu-available = true (выставляется из Rust по детекту).
    in property <bool> discrete-gpu-available;
    in property <string> discrete-gpu-label;
    in property <bool> use-discrete-gpu;
    in property <bool> discord-rpc-enabled: true;
    in property <string> install-folder;
    in property <[NewsItem]> news-items;
    in property <string> anticheat-alert;

    // Автообновление: статус скачивания, готовность к перезапуску,
    // обязательность (блокирует кнопку «Играть» до перезапуска).
    in property <bool> update-ready;
    in property <bool> update-mandatory;
    in property <string> update-version;
    in property <string> update-status;

    // Политика конфиденциальности: видимость оверлея, текст и версия.
    // policy-accepting: true пока in-flight запрос accept — блокирует повторный клик.
    in property <bool> policy-visible;
    in property <bool> policy-accepting;
    in property <string> policy-text;
    in property <string> policy-version-label;
    in property <int> policy-version;

    callback login-requested(string, string, string);
    callback server-selected(int);
    callback open-mods-folder-requested();
    callback anticheat-alert-dismiss();
    callback logout-requested();
    callback policy-accept-requested();
    callback play-requested();
    callback update-restart-requested();
    callback settings-requested();
    callback settings-close-requested();
    callback memory-auto-requested();
    callback memory-decrease-requested();
    callback memory-increase-requested();
    // Перетаскивание слайдера памяти: целевое значение в ГБ.
    callback memory-set-requested(int);
    // Переключатель дискретной видеокарты: передаёт новое состояние.
    callback discrete-gpu-requested(bool);
    callback discord-rpc-requested(bool);
    callback open-install-folder-requested();
    callback change-install-folder-requested();
    callback open-url(string);

    Rectangle {
        width: parent.width;
        height: parent.height;
        opacity: startup-opacity;
        animate opacity { duration: 600ms; easing: ease-out-quint; }

        Image {
            source: @image-url("../assets/background-13d.png");
            image-fit: cover;
            width: parent.width;
            height: parent.height;
        }

        Rectangle {
            background: #0000008f;
        }

        login-card := Rectangle {
            property <length> mirror-shift: root.server-visible ? 86px : 0px;
            width: 520px;
            height: 444px + self.mirror-shift;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (root.is-loading ? -6px : 0px);
            visible: !root.is-authenticated;
            border-radius: 12px;
            background: #090c10f5;
            border-color: root.is-loading ? #ffb02078 : #9eaab82e;
            border-width: 1px;
            drop-shadow-blur: root.is-loading ? 40px : 28px;
            drop-shadow-color: root.is-loading ? #ffb0202f : #00000099;
            drop-shadow-offset-y: root.is-loading ? 14px : 9px;
            opacity: !root.is-authenticated ? 1.0 : 0.0;
            animate y { duration: 420ms; easing: ease-in-out-quint; }
            animate background, border-color { duration: 300ms; easing: ease-out-quint; }
            animate drop-shadow-blur, drop-shadow-offset-y { duration: 340ms; easing: ease-out-quint; }
            animate opacity { duration: 420ms; easing: ease-in-out-quint; }

            Rectangle {
                x: 24px;
                y: 24px;
                width: 40px;
                height: 40px;
                border-radius: 4px;
                background: #19212b;
                border-color: #ffb02078;
                border-width: 1px;

                PixelIcon {
                    source: @image-url("../assets/px/target.svg");
                    x: 8px;
                    y: 8px;
                    width: 24px;
                    height: 24px;
                    colorize: #ffb020;
                }
            }

            Text {
                text: "PROJECT MINECRAFT";
                font-family: "Minecraft Ten font cyrillic";
                x: 84px;
                y: 19px;
                width: parent.width - 108px;
                height: 50px;
                color: #f2ece0;
                font-size: 24px;
                font-weight: 400;
                letter-spacing: 0.5px;
                vertical-alignment: center;
                overflow: elide;
            }

            Rectangle {
                x: 24px;
                y: 88px;
                width: parent.width - 48px;
                height: 1px;
                background: #9eaab821;
            }

            if root.server-visible: PixelIcon {
                source: @image-url("../assets/px/server.svg");
                colorize: #ffb020;
                x: 40px;
                y: 116px;
                width: 20px;
                height: 20px;
            }

            if root.server-visible: Text {
                text: "Сервер";
                x: 66px;
                y: 112px;
                width: parent.width - 106px;
                height: 24px;
                color: #c7cdd6;
                font-size: 15px;
                font-weight: 800;
                vertical-alignment: center;
            }

            if root.server-visible: ComboBox {
                x: 40px;
                y: 142px;
                width: parent.width - 80px;
                height: 52px;
                enabled: !root.is-loading && !root.is-authenticated;
                model: root.server-names;
                current-index <=> root.server-index;
                selected(value) => { root.server-selected(self.current-index); }
            }

            PixelIcon {
                source: @image-url("../assets/px/user.svg");
                colorize: #ffb020;
                width: 20px;
                height: 20px;
                x: 40px;
                y: 116px + parent.mirror-shift;
            }

            Text {
                text: "Логин";
                x: 66px;
                y: 112px + parent.mirror-shift;
                width: parent.width - 106px;
                height: 24px;
                color: #c7cdd6;
                font-size: 15px;
                font-weight: 800;
                vertical-alignment: center;
            }

            login-input := PjmLineEdit {
                x: 40px;
                y: 142px + parent.mirror-shift;
                width: parent.width - 80px;
                height: 58px;
                font-size: 17px;
                enabled: !root.is-loading && !root.is-authenticated;
                text <=> root.login-value;
                accepted(_) => { password-input.request-focus(); }
            }

            PixelIcon {
                source: @image-url("../assets/px/lock.svg");
                colorize: #ffb020;
                width: 20px;
                height: 20px;
                x: 40px;
                y: 224px + parent.mirror-shift;
            }

            Text {
                text: "Пароль";
                x: 66px;
                y: 220px + parent.mirror-shift;
                width: parent.width - 106px;
                height: 24px;
                color: #c7cdd6;
                font-size: 15px;
                font-weight: 800;
                vertical-alignment: center;
            }

            password-input := PjmLineEdit {
                x: 40px;
                y: 250px + parent.mirror-shift;
                width: parent.width - 80px;
                height: 58px;
                font-size: 17px;
                enabled: !root.is-loading && !root.is-authenticated;
                text <=> root.password-value;
                input-type: password;
                accepted(_) => {
                    root.login-requested(root.login-value, root.password-value, root.totp-value);
                }
            }

            GoldButton {
                x: 40px;
                y: 330px + parent.mirror-shift;
                width: parent.width - 80px;
                height: 58px;
                label: root.is-loading ? "ПРОВЕРКА..." : "АВТОРИЗОВАТЬСЯ";
                icon-source: @image-url("../assets/px/corner-down-left.svg");
                enabled: !root.is-loading && !root.is-authenticated;
                clicked => {
                    root.login-requested(root.login-value, root.password-value, root.totp-value);
                }
            }

            if root.message != "" && !root.requires-totp: Text {
                text: root.message;
                x: 40px;
                y: 400px + parent.mirror-shift;
                width: parent.width - 80px;
                height: 24px;
                color: #9aa4b0;
                font-size: 12px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }
        }
        main-shell := Rectangle {
            width: parent.width;
            height: parent.height;
            y: root.is-authenticated ? 0px : 14px;
            visible: root.is-authenticated;
            background: transparent;
            opacity: root.is-authenticated ? 1.0 : 0.0;
            animate y { duration: 460ms; delay: 70ms; easing: ease-out-quint; }
            animate opacity { duration: 460ms; delay: 70ms; easing: ease-in-out-quint; }

            // Полноэкранная игровая сцена без боковой панели.
            Rectangle {
                x: 0px;
                y: 104px;
                width: parent.width;
                height: parent.height - 104px;
                background: @linear-gradient(180deg, #05080b42 0%, #05080b18 45%, #05080bd9 100%);
            }

            // Новости.
            Rectangle {
                x: 32px;
                y: 132px;
                width: parent.width - 64px;
                height: parent.height - 188px;
                background: transparent;
                opacity: root.is-authenticated && root.active-tab == 1 && !root.settings-visible ? 1.0 : 0.0;
                visible: self.opacity > 0.01;
                animate opacity { duration: 360ms; easing: ease-in-out-quint; }

                PixelIcon {
                    source: @image-url("../assets/px/article.svg");
                    x: 0px;
                    y: 0px;
                    width: 24px;
                    height: 24px;
                    colorize: #ffb020;
                }

                Text {
                    text: "НОВОСТИ ПРОЕКТА";
                    font-family: "Minecraft Ten font cyrillic";
                    x: 34px;
                    y: 0px;
                    width: parent.width - 34px;
                    height: 24px;
                    color: #f2ece0;
                    font-size: 15px;
                    font-weight: 400;
                    letter-spacing: 0.8px;
                }

                Rectangle {
                    x: 0px;
                    y: 36px;
                    width: parent.width;
                    height: parent.height - 36px;
                    background: transparent;

                    if root.news-items.length == 0: Text {
                        width: parent.width;
                        height: parent.height;
                        text: "Новостей пока нет";
                        color: #9aa4b0;
                        font-size: 14px;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    Flickable {
                        width: parent.width;
                        height: parent.height;
                        viewport-width: self.width;

                        VerticalLayout {
                            width: parent.width;
                            spacing: 12px;
                            padding-bottom: 8px;

                            for item[idx] in root.news-items: NewsCard {
                                title: item.title;
                                date: item.date;
                                body: item.body;
                                index: idx;
                            }
                        }
                    }
                }
            }

            // Поддержка.
            Rectangle {
                x: 32px;
                y: 132px;
                width: parent.width - 64px;
                height: parent.height - 188px;
                background: transparent;
                opacity: root.is-authenticated && root.active-tab == 2 && !root.settings-visible ? 1.0 : 0.0;
                visible: self.opacity > 0.01;
                animate opacity { duration: 360ms; easing: ease-in-out-quint; }

                PixelIcon {
                    source: @image-url("../assets/px/message-text.svg");
                    x: 0px;
                    y: 0px;
                    width: 24px;
                    height: 24px;
                    colorize: #ffb020;
                }

                Text {
                    text: "ПОДДЕРЖКА И СООБЩЕСТВО";
                    font-family: "Minecraft Ten font cyrillic";
                    x: 34px;
                    y: 0px;
                    width: parent.width - 34px;
                    height: 24px;
                    color: #f2ece0;
                    font-size: 15px;
                    font-weight: 400;
                    letter-spacing: 0.8px;
                }

                Text {
                    text: "Нужна помощь? Выберите удобный канал связи.";
                    x: 0px;
                    y: 48px;
                    width: parent.width;
                    height: 28px;
                    color: #c7cdd6;
                    font-size: 17px;
                    font-weight: 700;
                }

                DarkButton {
                    x: 0px;
                    y: 94px;
                    width: 232px;
                    label: "Discord-сервер";
                    icon-source: @image-url("../assets/px/message-text.svg");
                    icon-color: #f2ece0;
                    clicked => { root.open-url("https://discord.gg/zmeJMqH7j8"); }
                }

                DarkButton {
                    x: 246px;
                    y: 94px;
                    width: 232px;
                    label: "Telegram-канал";
                    icon-source: @image-url("../assets/px/external-link.svg");
                    icon-color: #f2ece0;
                    clicked => { root.open-url("https://t.me/project_minecraft"); }
                }
            }

            // Верхняя command-панель.
            Rectangle {
                x: 0px;
                y: 0px;
                width: parent.width;
                height: 104px;
                background: #0b0f14f5;
                border-color: #9eaab821;
                border-width: 1px;

                Image {
                    source: @image-url("../assets/logo.svg");
                    image-fit: contain;
                    x: 30px;
                    y: 27px;
                    width: 132px;
                    height: 50px;
                }

                Rectangle {
                    x: 180px;
                    y: 22px;
                    width: 1px;
                    height: 60px;
                    background: #9eaab821;
                }

                HorizontalLayout {
                    x: 200px;
                    y: 16px;
                    height: 72px;
                    spacing: root.width >= 1180px ? 20px : 8px;
                    opacity: root.is-authenticated ? 1.0 : 0.0;
                    animate opacity { duration: 380ms; delay: 80ms; easing: ease-in-out-quint; }

                    NavButton {
                        width: root.width >= 1180px ? 112px : 92px;
                        label: "ИГРА";
                        active: root.active-tab == 0 && !root.settings-visible;
                        icon-source: @image-url("../assets/px/gamepad.svg");
                        clicked => {
                            root.settings-close-requested();
                            root.active-tab = 0;
                        }
                    }
                    NavButton {
                        width: root.width >= 1180px ? 148px : 120px;
                        label: "НОВОСТИ";
                        active: root.active-tab == 1 && !root.settings-visible;
                        icon-source: @image-url("../assets/px/article.svg");
                        clicked => {
                            root.settings-close-requested();
                            root.active-tab = 1;
                        }
                    }
                    NavButton {
                        width: root.width >= 1180px ? 176px : 144px;
                        label: "НАСТРОЙКИ";
                        active: root.settings-visible;
                        icon-source: @image-url("../assets/px/cpu.svg");
                        clicked => { root.settings-requested(); }
                    }
                    NavButton {
                        width: root.width >= 1180px ? 168px : 156px;
                        label: "ПОДДЕРЖКА";
                        active: root.active-tab == 2 && !root.settings-visible;
                        icon-source: @image-url("../assets/px/message-text.svg");
                        clicked => {
                            root.settings-close-requested();
                            root.active-tab = 2;
                        }
                    }
                }

                Rectangle {
                    x: parent.width - 252px;
                    y: 20px;
                    width: 218px;
                    height: 64px;
                    background: transparent;

                    Rectangle {
                        x: 0px;
                        y: 8px;
                        width: 48px;
                        height: 48px;
                        border-radius: 4px;
                        background: account-touch.has-hover ? #273340 : #19212b;
                        border-color: account-touch.has-hover ? #ffb02078 : #9eaab821;
                        border-width: 1px;
                        animate background, border-color { duration: 180ms; easing: ease-out-quint; }

                        PixelIcon {
                            source: @image-url("../assets/px/user.svg");
                            x: 12px;
                            y: 12px;
                            width: 24px;
                            height: 24px;
                            colorize: account-touch.has-hover ? #ffb020 : #c7cdd6;
                            animate colorize { duration: 180ms; easing: ease-out-quint; }
                        }

                        account-touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { account-popup.show(); }
                        }

                        account-popup := PopupWindow {
                            x: 48px - 320px;
                            y: 54px;
                            width: 320px;
                            height: 118px;

                            Rectangle {
                                background: #0e1319fa;
                                border-radius: 6px;
                                border-width: 1px;
                                border-color: #9eaab847;

                                VerticalLayout {
                                    padding: 18px;
                                    spacing: 7px;
                                    alignment: center;

                                    Text {
                                        text: root.user-login;
                                        color: #f2ece0;
                                        font-size: 16px;
                                        font-weight: 900;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: "UUID: " + root.user-uuid;
                                        color: #9aa4b0;
                                        font-size: 12px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    if root.token-expires-at != "": Text {
                                        text: "Сессия до: " + root.token-expires-at;
                                        color: #9aa4b0;
                                        font-size: 12px;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                }
                            }
                        }
                    }

                    Text {
                        text: root.user-login;
                        x: 60px;
                        y: 9px;
                        width: 102px;
                        height: 24px;
                        color: #f2ece0;
                        font-size: 14px;
                        font-weight: 800;
                        vertical-alignment: center;
                        overflow: elide;
                    }

                    Text {
                        text: "● В сети";
                        x: 60px;
                        y: 33px;
                        width: 102px;
                        height: 20px;
                        color: #7ecb82;
                        font-size: 12px;
                        font-weight: 700;
                        vertical-alignment: center;
                    }

                    IconButton {
                        x: 172px;
                        y: 8px;
                        icon-source: @image-url("../assets/px/logout.svg");
                        danger: true;
                        clicked => { root.logout-requested(); }
                    }
                }

                // Линия готовности: активная навигация сверху, прогресс загрузки снизу.
                Rectangle {
                    x: 0px;
                    y: parent.height - 2px;
                    width: parent.width;
                    height: 2px;
                    background: #ffb020;
                    opacity: root.is-syncing ? 0.28 : 0.65;
                    animate opacity { duration: 260ms; easing: ease-out-quint; }
                }
            }

            // Быстрые действия вместо sidebar.
            Rectangle {
                x: 32px;
                y: parent.height - 84px;
                width: 288px;
                height: 52px;
                visible: root.active-tab == 0 && !root.settings-visible && !root.is-syncing;

                DarkButton {
                    x: 0px;
                    y: 0px;
                    width: 168px;
                    height: 52px;
                    label: "ПАПКА МОДОВ";
                    icon-source: @image-url("../assets/px/folder.svg");
                    icon-color: #c7cdd6;
                    enabled: root.has-profile;
                    clicked => { root.open-mods-folder-requested(); }
                }

                SocialButton {
                    x: 180px;
                    y: 0px;
                    icon-source: @image-url("../assets/discord.svg");
                    brand-color: #5865f2;
                    clicked => { root.open-url("https://discord.gg/zmeJMqH7j8"); }
                }

                SocialButton {
                    x: 236px;
                    y: 0px;
                    icon-source: @image-url("../assets/telegram.svg");
                    brand-color: #229ed9;
                    clicked => { root.open-url("https://t.me/project_minecraft"); }
                }
            }

            launch-dock := Rectangle {
                property <bool> dl-done: root.download-progress >= 1.0;
                property <bool> dl-pulse: false;
                property <bool> dl-error: root.download-panel-visible && !root.is-syncing;
                property <length> content-width: min(660px, root.width - 344px);

                Timer {
                    interval: 850ms;
                    running: root.is-syncing && !launch-dock.dl-done;
                    triggered => { launch-dock.dl-pulse = !launch-dock.dl-pulse; }
                }

                x: parent.width - self.width - 32px;
                y: parent.height - self.height - 32px;
                width: self.content-width + (root.is-syncing ? 80px : 0px);
                height: 172px;
                opacity: root.is-authenticated && root.active-tab == 0 && !root.settings-visible ? 1.0 : 0.0;
                visible: self.opacity > 0.01;
                border-radius: 6px;
                background: #0e1319f2;
                border-color: root.is-syncing ? #ffb02078 : #9eaab847;
                border-width: 1px;
                drop-shadow-blur: root.is-syncing ? 32px : 22px;
                drop-shadow-color: root.is-syncing ? #ffb0202f : #00000099;
                drop-shadow-offset-y: 9px;
                clip: true;
                animate width { duration: 420ms; easing: ease-out-quint; }
                animate opacity { duration: 340ms; easing: ease-in-out-quint; }
                animate border-color, drop-shadow-blur { duration: 300ms; easing: ease-out-quint; }

                Rectangle {
                    x: 0px;
                    y: 0px;
                    width: parent.width;
                    height: 3px;
                    background: #19212b;

                    Rectangle {
                        x: 0px;
                        y: 0px;
                        width: root.is-syncing ? parent.width * root.download-progress : parent.width;
                        height: parent.height;
                        background: #ffb020;
                        animate width { duration: 320ms; easing: ease-out-quint; }
                    }
                }

                Rectangle {
                    x: 0px;
                    y: 3px;
                    width: parent.width - launch-dock.content-width;
                    height: parent.height - 3px;
                    opacity: root.is-syncing ? 1.0 : 0.0;
                    animate opacity { duration: 280ms; easing: ease-out-quint; }

                    PixelIcon {
                        source: launch-dock.dl-done
                            ? @image-url("../assets/px/check.svg")
                            : @image-url("../assets/px/download.svg");
                        x: (parent.width - 24px) / 2;
                        y: (parent.height - 24px) / 2;
                        width: 24px;
                        height: 24px;
                        colorize: launch-dock.dl-done ? #f2ece0 : #ffb020;
                    }
                }

                Rectangle {
                    x: parent.width - launch-dock.content-width;
                    y: 3px;
                    width: launch-dock.content-width;
                    height: parent.height - 3px;
                    background: transparent;

                    Text {
                        text: root.has-profile ? root.selected-profile-name : "Сборка не выбрана";
                        x: 24px;
                        y: 16px;
                        width: 340px;
                        height: 28px;
                        color: #f2ece0;
                        font-size: 18px;
                        font-weight: 900;
                        overflow: elide;
                    }

                    Rectangle {
                        x: 24px;
                        y: 50px;
                        width: 4px;
                        height: 104px;
                        background: #ffb020;
                    }

                    Text {
                        text: "Версия";
                        x: 44px;
                        y: 50px;
                        width: 84px;
                        height: 22px;
                        color: #7f8794;
                        font-size: 13px;
                        font-weight: 800;
                    }
                    Text {
                        text: root.selected-profile-version;
                        x: 132px;
                        y: 50px;
                        width: 190px;
                        height: 22px;
                        color: #c7cdd6;
                        font-size: 15px;
                        font-weight: 800;
                        overflow: elide;
                    }

                    Text {
                        text: "Статус";
                        x: 44px;
                        y: 76px;
                        width: 84px;
                        height: 22px;
                        color: #7f8794;
                        font-size: 13px;
                        font-weight: 800;
                    }
                    Text {
                        text: root.is-syncing || launch-dock.dl-error
                            ? root.download-phase
                            : root.profile-status;
                        x: 132px;
                        y: 76px;
                        width: 190px;
                        height: 22px;
                        color: launch-dock.dl-error ? #ff6b6b
                            : (root.is-syncing ? (launch-dock.dl-pulse ? #f2ece0 : #9aa4b0) : #c7cdd6);
                        font-size: 15px;
                        font-weight: 800;
                        overflow: elide;
                        animate color { duration: 850ms; easing: ease-in-out-sine; }
                    }

                    Text {
                        text: root.is-syncing ? "Прогресс" : (launch-dock.dl-error ? "Причина" : "Клиент");
                        x: 44px;
                        y: 102px;
                        width: 84px;
                        height: 22px;
                        color: #7f8794;
                        font-size: 13px;
                        font-weight: 800;
                    }
                    Text {
                        text: root.is-syncing
                            ? "\{round(root.download-progress * 100)}% · " + root.download-counter
                            : (launch-dock.dl-error ? root.download-file : (root.has-profile ? "Готов" : "Отключен"));
                        x: 132px;
                        y: 102px;
                        width: 190px;
                        height: 22px;
                        color: launch-dock.dl-error ? #ff6b6b : #c7cdd6;
                        font-size: 15px;
                        font-weight: 800;
                        overflow: elide;
                    }

                    Text {
                        text: "Наиграно";
                        x: 44px;
                        y: 128px;
                        width: 84px;
                        height: 22px;
                        color: #7f8794;
                        font-size: 13px;
                        font-weight: 800;
                    }
                    Text {
                        text: root.playtime-total;
                        x: 132px;
                        y: 128px;
                        width: 190px;
                        height: 22px;
                        color: #c7cdd6;
                        font-size: 15px;
                        font-weight: 800;
                        overflow: elide;
                    }

                    PlayButton {
                        x: parent.width - 294px;
                        y: 46px;
                        width: 270px;
                        height: 84px;
                        label: root.update-mandatory ? "ТРЕБУЕТСЯ ОБНОВЛЕНИЕ"
                            : (root.is-syncing ? "ЗАГРУЗКА..."
                                : (root.profile-state-checking ? "ПРОВЕРКА..."
                                    : (root.profile-state-unknown ? "ПРОВЕРИТЬ"
                                        : (!root.profile-installed ? "УСТАНОВИТЬ"
                                            : (root.profile-update-available ? "ОБНОВИТЬ" : "ИГРАТЬ")))));
                        icon-source: @image-url("../assets/px/play.svg");
                        enabled: root.has-profile && !root.is-syncing
                            && !root.profile-state-checking && !root.update-mandatory;
                        clicked => { root.play-requested(); }
                    }
                }
            }
        }
    settings-layer := Rectangle {
        width: parent.width;
        height: parent.height;
        background: #030507cc;
        opacity: root.settings-visible && root.is-authenticated ? 1.0 : 0.0;
        animate opacity { duration: 320ms; easing: ease-out-quint; }

        settings-backdrop := TouchArea {
            enabled: root.settings-visible && root.is-authenticated;
            clicked => { root.settings-close-requested(); }
        }

        // Esc закрывает настройки; фокус выставляется при открытии (см. changed выше).
        settings-esc := FocusScope {
            width: 0px;
            height: 0px;
            enabled: root.settings-visible && root.is-authenticated;
            key-pressed(event) => {
                if (event.text == Key.Escape) {
                    root.settings-close-requested();
                    return accept;
                }
                reject
            }
        }

        settings-card := Rectangle {
            width: 920px;
            height: 572px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 + (root.settings-visible ? 0px : 12px);
            border-radius: 8px;
            background: #0e1319fa;
            border-color: root.settings-visible ? #9eaab847 : #9eaab800;
            border-width: 1px;
            opacity: root.settings-visible && root.is-authenticated ? 1.0 : 0.0;
            drop-shadow-blur: root.settings-visible ? 34px : 8px;
            drop-shadow-color: root.settings-visible ? #000000aa : #00000000;
            drop-shadow-offset-y: root.settings-visible ? 14px : 4px;
            animate y { duration: 380ms; easing: ease-out-quint; }
            animate opacity, border-color { duration: 320ms; easing: ease-out-quint; }
            animate drop-shadow-blur, drop-shadow-offset-y { duration: 380ms; easing: ease-out-quint; }

            settings-card-blocker := TouchArea {
                enabled: root.settings-visible && root.is-authenticated;
            }

            // Шапка повторяет анатомию панелей WEB: отдельная поверхность и тонкая
            // янтарная линия, без изменения узнаваемой геометрии лаунчера.
            Rectangle {
                x: 1px;
                y: 1px;
                width: parent.width - 2px;
                height: 76px;
                border-radius: 7px;
                background: #0b0f14;
            }

            Rectangle {
                x: 1px;
                y: 76px;
                width: parent.width - 2px;
                height: 2px;
                background: #ffb020;
            }

            Rectangle {
                x: 24px;
                y: 16px;
                width: 40px;
                height: 40px;
                border-radius: 4px;
                background: #19212b;
                border-color: #ffb02078;
                border-width: 1px;

                PixelIcon {
                    source: @image-url("../assets/px/cpu.svg");
                    x: 8px;
                    y: 8px;
                    width: 24px;
                    height: 24px;
                    colorize: #ffb020;
                }
            }

            Text {
                text: "НАСТРОЙКИ ЛАУНЧЕРА";
                font-family: "Minecraft Ten font cyrillic";
                x: 78px;
                y: 8px;
                width: 320px;
                height: 38px;
                color: #f2ece0;
                font-size: 18px;
                font-weight: 900;
                letter-spacing: 1px;
                vertical-alignment: center;
                overflow: elide;
            }

            Text {
                text: "PROJECT MINECRAFT · ПАРАМЕТРЫ ЛАУНЧЕРА";
                x: 78px;
                y: 42px;
                width: 360px;
                height: 18px;
                color: #7f8794;
                font-size: 11px;
                font-weight: 800;
                letter-spacing: 0.8px;
                overflow: elide;
            }

            Text {
                text: "ИЗМЕНЕНИЯ СОХРАНЯЮТСЯ АВТОМАТИЧЕСКИ";
                x: parent.width - 424px;
                y: 28px;
                width: 340px;
                height: 18px;
                color: #9aa4b0;
                font-size: 11px;
                font-weight: 800;
                letter-spacing: 0.7px;
                horizontal-alignment: right;
                overflow: elide;
            }

            Rectangle {
                x: parent.width - 60px;
                y: 20px;
                width: 36px;
                height: 36px;
                border-radius: 4px;
                background: close-settings.pressed ? #4a1919 : (close-settings.has-hover ? #321416 : #19212b);
                border-color: close-settings.has-hover ? #ff6b6b88 : #9eaab821;
                border-width: 1px;
                animate background, border-color { duration: 180ms; easing: ease-out-quint; }

                PixelIcon {
                    source: @image-url("../assets/px/close.svg");
                    x: 8px;
                    y: 8px;
                    width: 20px;
                    height: 20px;
                    colorize: close-settings.has-hover ? #ff8a8a : #c7cdd6;
                    animate colorize { duration: 180ms; easing: ease-out-quint; }
                }

                close-settings := TouchArea {
                    enabled: root.settings-visible && root.is-authenticated;
                    mouse-cursor: pointer;
                    clicked => { root.settings-close-requested(); }
                }
            }

            // Левая колонка: всё, что влияет на производительность игры.
            Text {
                text: "ПРОИЗВОДИТЕЛЬНОСТЬ";
                font-family: "Minecraft Ten font cyrillic";
                x: 24px;
                y: 98px;
                width: 420px;
                height: 18px;
                color: #ffb020;
                font-size: 12px;
                font-weight: 900;
                letter-spacing: 1px;
            }

            memory-card := Rectangle {
                x: 24px;
                y: 122px;
                width: 420px;
                height: 198px;
                border-radius: 5px;
                background: #111820;
                border-color: #9eaab821;
                border-width: 1px;

                Text {
                    text: "Оперативная память";
                    x: 18px;
                    y: 14px;
                    width: 250px;
                    height: 22px;
                    color: #f2ece0;
                    font-size: 15px;
                    font-weight: 800;
                    overflow: elide;
                }

                Rectangle {
                    x: parent.width - 112px;
                    y: 12px;
                    width: 94px;
                    height: 28px;
                    border-radius: 4px;
                    background: root.memory-auto ? #ffb020 : #19212b;
                    border-color: root.memory-auto ? #ffc14d : #9eaab821;
                    border-width: 1px;
                    animate background, border-color { duration: 180ms; easing: ease-out-quint; }

                    Text {
                        text: root.memory-auto ? "АВТО" : "ВРУЧНУЮ";
                        color: root.memory-auto ? #0b0f14 : #9aa4b0;
                        font-size: 11px;
                        font-weight: 900;
                        letter-spacing: 0.7px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: root.memory-auto ? "АВТО · " + root.memory-gb + " ГБ" : root.memory-gb + " ГБ";
                    x: 18px;
                    y: 36px;
                    width: parent.width - 36px;
                    height: 46px;
                    color: #f2ece0;
                    font-size: 24px;
                    font-weight: 900;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }

                Rectangle {
                    x: 18px;
                    y: 84px;
                    width: parent.width - 36px;
                    height: 22px;
                    background: transparent;

                    Rectangle {
                        y: (parent.height - 4px) / 2;
                        width: parent.width;
                        height: 4px;
                        border-radius: 2px;
                        background: #090c10;
                        border-color: #9eaab821;
                        border-width: 1px;

                        memory-fill := Rectangle {
                            x: 0px;
                            width: max(8px, parent.width * (root.memory-gb - 2) / max(1, root.memory-max - 2));
                            height: parent.height;
                            border-radius: 2px;
                            background: #ffb020;
                            animate width { duration: 220ms; easing: ease-out-quint; }
                        }
                    }

                    Rectangle {
                        x: memory-fill.width - 8px;
                        y: (parent.height - 16px) / 2;
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        background: memory-slider-touch.has-hover || memory-slider-touch.pressed ? #ffffff : #f2ece0;
                        border-width: 2px;
                        border-color: #ffb020;
                        animate x { duration: 220ms; easing: ease-out-quint; }
                    }

                    memory-slider-touch := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        enabled: root.settings-visible && root.is-authenticated;
                        mouse-cursor: pointer;
                        pointer-event(event) => {
                            if (event.kind == PointerEventKind.down || (event.kind == PointerEventKind.move && self.pressed)) {
                                root.memory-set-requested(Math.max(2, Math.min(root.memory-max,
                                    2 + Math.round((self.mouse-x / self.width) * (root.memory-max - 2)))));
                            }
                        }
                    }
                }

                Text {
                    text: "2 ГБ";
                    x: 18px;
                    y: 106px;
                    width: 90px;
                    height: 16px;
                    color: #7f8794;
                    font-size: 11px;
                    font-weight: 700;
                }

                Text {
                    text: root.memory-max + " ГБ";
                    x: parent.width - 108px;
                    y: 106px;
                    width: 90px;
                    height: 16px;
                    color: #7f8794;
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-alignment: right;
                }

                MiniButton {
                    x: 18px;
                    y: 140px;
                    width: 48px;
                    height: 40px;
                    label: "−";
                    enabled: root.settings-visible && root.is-authenticated && root.memory-gb > 2;
                    clicked => { root.memory-decrease-requested(); }
                }

                Rectangle {
                    x: 76px;
                    y: 140px;
                    width: 186px;
                    height: 40px;
                    border-radius: 4px;
                    background: #090c10;
                    border-color: #9eaab821;
                    border-width: 1px;

                    Text {
                        text: root.memory-auto ? "СИСТЕМА ВЫБРАЛА ОПТИМУМ" : "РУЧНОЕ ОГРАНИЧЕНИЕ";
                        color: #9aa4b0;
                        font-size: 10px;
                        font-weight: 800;
                        letter-spacing: 0.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                MiniButton {
                    x: 272px;
                    y: 140px;
                    width: 48px;
                    height: 40px;
                    label: "+";
                    enabled: root.settings-visible && root.is-authenticated && root.memory-gb < root.memory-max;
                    clicked => { root.memory-increase-requested(); }
                }

                SettingsButton {
                    x: 330px;
                    y: 140px;
                    width: 72px;
                    height: 40px;
                    label: "АВТО";
                    primary: root.memory-auto;
                    enabled: root.settings-visible && root.is-authenticated;
                    clicked => { root.memory-auto-requested(); }
                }
            }

            Text {
                text: "СИСТЕМА";
                font-family: "Minecraft Ten font cyrillic";
                x: 24px;
                y: 340px;
                width: 420px;
                height: 18px;
                color: #ffb020;
                font-size: 12px;
                font-weight: 900;
                letter-spacing: 1px;
            }

            performance-card := Rectangle {
                x: 24px;
                y: 364px;
                width: 420px;
                height: 184px;
                border-radius: 5px;
                background: #111820;
                border-color: #9eaab821;
                border-width: 1px;

                Rectangle {
                    x: 12px;
                    y: 12px;
                    width: parent.width - 24px;
                    height: 72px;
                    border-radius: 4px;
                    background: gpu-row-touch.has-hover && root.discrete-gpu-available ? #273340 : #19212b;
                    border-color: gpu-row-touch.has-hover && root.discrete-gpu-available ? #ffb02078 : #9eaab821;
                    border-width: 1px;
                    animate background, border-color { duration: 180ms; easing: ease-out-quint; }

                    Text {
                        text: "Дискретная видеокарта";
                        x: 14px;
                        y: 11px;
                        width: parent.width - 118px;
                        height: 20px;
                        color: #f2ece0;
                        font-size: 14px;
                        font-weight: 800;
                        overflow: elide;
                    }

                    Text {
                        text: root.discrete-gpu-available
                            ? root.discrete-gpu-label + " · рендер игры"
                            : "Управляется системой автоматически";
                        x: 14px;
                        y: 36px;
                        width: parent.width - 118px;
                        height: 18px;
                        color: #7f8794;
                        font-size: 12px;
                        font-weight: 600;
                        overflow: elide;
                    }

                    if root.discrete-gpu-available: SettingsToggle {
                        x: parent.width - 86px;
                        y: 21px;
                        checked: root.use-discrete-gpu;
                        enabled: root.settings-visible && root.is-authenticated;
                        toggled(value) => { root.discrete-gpu-requested(value); }
                    }

                    if !root.discrete-gpu-available: Text {
                        text: "СИСТЕМНО";
                        x: parent.width - 94px;
                        y: 0px;
                        width: 78px;
                        height: parent.height;
                        color: #7f8794;
                        font-size: 10px;
                        font-weight: 900;
                        letter-spacing: 0.5px;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }

                    gpu-row-touch := TouchArea {
                        enabled: root.settings-visible && root.is-authenticated && root.discrete-gpu-available;
                        mouse-cursor: pointer;
                        clicked => { root.discrete-gpu-requested(!root.use-discrete-gpu); }
                    }
                }

                Rectangle {
                    x: 12px;
                    y: 96px;
                    width: parent.width - 24px;
                    height: 72px;
                    border-radius: 4px;
                    background: discord-row-touch.has-hover ? #273340 : #19212b;
                    border-color: discord-row-touch.has-hover ? #ffb02078 : #9eaab821;
                    border-width: 1px;
                    animate background, border-color { duration: 180ms; easing: ease-out-quint; }

                    Text {
                        text: "Discord Rich Presence";
                        x: 14px;
                        y: 11px;
                        width: parent.width - 118px;
                        height: 20px;
                        color: #f2ece0;
                        font-size: 14px;
                        font-weight: 800;
                        overflow: elide;
                    }

                    Text {
                        text: "Показывать статус игры в профиле";
                        x: 14px;
                        y: 36px;
                        width: parent.width - 118px;
                        height: 18px;
                        color: #7f8794;
                        font-size: 12px;
                        font-weight: 600;
                        overflow: elide;
                    }

                    SettingsToggle {
                        x: parent.width - 86px;
                        y: 21px;
                        checked: root.discord-rpc-enabled;
                        enabled: root.settings-visible && root.is-authenticated;
                        toggled(value) => { root.discord-rpc-requested(value); }
                    }

                    discord-row-touch := TouchArea {
                        enabled: root.settings-visible && root.is-authenticated;
                        mouse-cursor: pointer;
                        clicked => { root.discord-rpc-requested(!root.discord-rpc-enabled); }
                    }
                }
            }

            // Правая колонка: файлы, сеть и краткая подсказка по применению.
            Text {
                text: "ХРАНИЛИЩЕ";
                font-family: "Minecraft Ten font cyrillic";
                x: 460px;
                y: 98px;
                width: 436px;
                height: 18px;
                color: #ffb020;
                font-size: 12px;
                font-weight: 900;
                letter-spacing: 1px;
            }

            storage-card := Rectangle {
                x: 460px;
                y: 122px;
                width: 436px;
                height: 164px;
                border-radius: 5px;
                background: #111820;
                border-color: #9eaab821;
                border-width: 1px;

                Text {
                    text: "Папка установки";
                    x: 16px;
                    y: 12px;
                    width: parent.width - 32px;
                    height: 20px;
                    color: #f2ece0;
                    font-size: 14px;
                    font-weight: 800;
                    overflow: elide;
                }

                Rectangle {
                    x: 16px;
                    y: 42px;
                    width: parent.width - 32px;
                    height: 44px;
                    border-radius: 4px;
                    background: #090c10;
                    border-color: #9eaab821;
                    border-width: 1px;

                    PixelIcon {
                        source: @image-url("../assets/px/folder.svg");
                        x: 12px;
                        y: 12px;
                        width: 20px;
                        height: 20px;
                        colorize: #ffb020;
                    }

                    Text {
                        text: root.install-folder;
                        x: 40px;
                        y: 0px;
                        width: parent.width - 52px;
                        height: parent.height;
                        color: #c7cdd6;
                        font-size: 12px;
                        font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                SettingsButton {
                    x: 16px;
                    y: 104px;
                    width: 190px;
                    label: "ОТКРЫТЬ ПАПКУ";
                    enabled: root.settings-visible && root.is-authenticated;
                    clicked => { root.open-install-folder-requested(); }
                }

                SettingsButton {
                    x: 218px;
                    y: 104px;
                    width: 202px;
                    label: root.is-syncing ? "ИДЁТ СИНХРОНИЗАЦИЯ" : "СМЕНИТЬ ДИСК";
                    primary: !root.is-syncing;
                    enabled: root.settings-visible && root.is-authenticated && !root.is-syncing;
                    clicked => { root.change-install-folder-requested(); }
                }
            }

            Text {
                text: "ПОДКЛЮЧЕНИЕ";
                font-family: "Minecraft Ten font cyrillic";
                x: 460px;
                y: 306px;
                width: 436px;
                height: 18px;
                color: #ffb020;
                font-size: 12px;
                font-weight: 900;
                letter-spacing: 1px;
            }

            connection-card := Rectangle {
                x: 460px;
                y: 330px;
                width: 436px;
                height: 112px;
                border-radius: 5px;
                background: #111820;
                border-color: #9eaab821;
                border-width: 1px;

                Text {
                    text: root.server-visible
                        ? "«Авто» выбирает самый быстрый доступный сервер"
                        : "Доступен один адрес — выбор выполняется автоматически";
                    x: 16px;
                    y: 12px;
                    width: parent.width - 32px;
                    height: 18px;
                    color: #7f8794;
                    font-size: 12px;
                    font-weight: 600;
                    overflow: elide;
                }

                if root.server-visible: ComboBox {
                    x: 16px;
                    y: 46px;
                    width: parent.width - 32px;
                    height: 48px;
                    enabled: root.settings-visible;
                    model: root.server-names;
                    current-index <=> root.server-index;
                    selected(value) => { root.server-selected(self.current-index); }
                }

                if !root.server-visible: Rectangle {
                    x: 16px;
                    y: 46px;
                    width: parent.width - 32px;
                    height: 48px;
                    border-radius: 4px;
                    background: #19212b;
                    border-color: #9eaab821;
                    border-width: 1px;

                    Text {
                        text: "АВТО · ОСНОВНОЙ СЕРВЕР";
                        x: 14px;
                        width: parent.width - 28px;
                        height: parent.height;
                        color: #c7cdd6;
                        font-size: 12px;
                        font-weight: 900;
                        letter-spacing: 0.6px;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        x: parent.width - 24px;
                        y: (parent.height - 8px) / 2;
                        width: 8px;
                        height: 8px;
                        border-radius: 4px;
                        background: #ffb020;
                    }
                }
            }

            Rectangle {
                x: 460px;
                y: 462px;
                width: 436px;
                height: 86px;
                border-radius: 5px;
                background: #0b0f14;
                border-color: #9eaab821;
                border-width: 1px;

                Rectangle {
                    x: 0px;
                    width: 3px;
                    height: parent.height;
                    background: #ffb020;
                }

                Text {
                    text: "КАК ПРИМЕНЯЮТСЯ НАСТРОЙКИ";
                    x: 18px;
                    y: 13px;
                    width: parent.width - 36px;
                    height: 17px;
                    color: #ffb020;
                    font-size: 10px;
                    font-weight: 900;
                    letter-spacing: 0.8px;
                    overflow: elide;
                }

                Text {
                    text: "Память и видеокарта — при следующем запуске игры.\nDiscord, папка и сервер — сразу после выбора.";
                    x: 18px;
                    y: 36px;
                    width: parent.width - 36px;
                    height: 38px;
                    color: #9aa4b0;
                    font-size: 11px;
                    font-weight: 600;
                    wrap: word-wrap;
                    overflow: elide;
                }
            }
        }
    }

    totp-layer := Rectangle {
        background: #00000099;
        opacity: root.requires-totp && !root.is-authenticated ? 1.0 : 0.0;
        animate opacity { duration: 300ms; easing: ease-in-out-quint; }

        Rectangle {
            width: 438px;
            height: 392px;
            x: (parent.width - 438px) / 2;
            y: 188px + (root.requires-totp && !root.is-authenticated ? 0px : 18px);
            border-radius: 22px;
            border-color: root.requires-totp && !root.is-authenticated ? #2f2720 : #22222200;
            border-width: 1px;
            background: #000000;
            drop-shadow-blur: root.requires-totp && !root.is-authenticated ? 34px : 8px;
            drop-shadow-color: root.requires-totp && !root.is-authenticated ? #000000aa : #00000000;
            drop-shadow-offset-y: root.requires-totp && !root.is-authenticated ? 14px : 4px;
            animate y { duration: 420ms; easing: ease-in-out-quint; }
            animate border-color { duration: 300ms; easing: ease-out-quint; }
            animate drop-shadow-blur { duration: 320ms; easing: ease-out-quint; }
            animate drop-shadow-offset-y { duration: 320ms; easing: ease-out-quint; }

            Text {
                text: "2FA аутентификация";
                x: 44px;
                y: 72px;
                width: parent.width - 88px;
                color: #e0e2e5;
                font-size: 26px;
                font-weight: 900;
                horizontal-alignment: center;
            }

            Text {
                text: "Пожалуйста, введите код\nподтверждения из вашего\nприложения аутентификации";
                x: 54px;
                y: 112px;
                width: parent.width - 108px;
                color: #b4b7bc;
                font-size: 20px;
                font-weight: 800;
                horizontal-alignment: center;
            }

            if root.message != "": Text {
                text: root.message;
                x: 40px;
                y: 194px;
                width: parent.width - 80px;
                color: #ff6b6b;
                font-size: 13px;
                font-weight: 700;
                horizontal-alignment: center;
                overflow: elide;
            }

            modal-totp-input := PjmLineEdit {
                x: 40px;
                y: 226px;
                width: parent.width - 80px;
                height: 66px;
                font-size: 20px;
                enabled: root.requires-totp && !root.is-authenticated && !root.is-loading;
                text <=> root.totp-value;
                accepted(_) => {
                    root.login-requested(root.login-value, root.password-value, root.totp-value);
                }
            }

            DarkButton {
                x: 118px;
                y: 318px;
                width: 220px;
                height: 56px;
                label: root.is-loading ? "Проверка..." : "Подтвердить";
                icon-source: @image-url("../assets/px/lock.svg");
                enabled: root.requires-totp && !root.is-authenticated && !root.is-loading && root.totp-value != "";
                clicked => {
                    root.login-requested(root.login-value, root.password-value, root.totp-value);
                }
            }
        }
    }
    }

    // Плавающий баннер необязательного автообновления (верхний правый угол,
    // под шапкой — внизу справа он перекрывал кнопку «Играть»).
    // Обязательное обновление показывается полноэкранным оверлеем ниже.
    if (root.update-status != "" || root.update-ready) && !root.update-mandatory: Rectangle {
        width: 450px;
        height: 76px;
        x: parent.width - self.width - 20px;
        y: root.is-authenticated ? 118px : 20px;
        background: #14141cf2;
        border-radius: 16px;
        border-width: 1px;
        border-color: root.update-ready ? #6fdd8b55 : #ffffff22;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000090;

        HorizontalLayout {
            padding: 14px;
            spacing: 12px;

            VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    border-radius: 24px;
                    background: #6fdd8b1f;
                    border-width: 1px;
                    border-color: root.update-ready ? #6fdd8b : #6fdd8b55;
                    PixelIcon {
                        source: @image-url("../assets/px/reload.svg");
                        colorize: #6fdd8b;
                        width: 24px;
                        height: 24px;
                        x: 12px;
                        y: 12px;
                    }
                }
            }

            VerticalLayout {
                alignment: center;
                spacing: 3px;
                Text {
                    text: root.update-ready ? "Обновление готово" : "Обновление лаунчера";
                    color: #ffffff;
                    font-size: 14px;
                    font-weight: 800;
                    overflow: elide;
                }
                Text {
                    text: root.update-ready
                        ? "Версия \{root.update-version}"
                        : root.update-status;
                    color: #989ca2;
                    font-size: 12px;
                    font-weight: 700;
                    overflow: elide;
                }
            }

            if root.update-ready: VerticalLayout {
                alignment: center;
                Rectangle {
                    width: 138px;
                    height: 40px;
                    border-radius: 11px;
                    background: restart-area.has-hover ? #7be89a : #6fdd8b;
                    animate background { duration: 180ms; easing: ease-out-quint; }
                    restart-area := TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: pointer;
                        clicked => {
                            root.update-restart-requested();
                        }
                    }
                    Text {
                        text: "Перезапустить";
                        color: #0c0c12;
                        font-size: 14px;
                        font-weight: 800;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
            }
        }
    }

    // Полноэкранное уведомление об обязательном обновлении: блокирует весь
    // интерфейс до перезапуска (дизайн зеркалит античит-оверлей ниже).
    if root.update-mandatory && (root.update-status != "" || root.update-ready): Rectangle {
        width: parent.width;
        height: parent.height;
        background: #08080fee;

        // Перехватываем все клики, чтобы интерфейс под оверлеем был недоступен.
        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        Rectangle {
            width: min(parent.width - 80px, 540px);
            height: 380px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #14141c;
            border-radius: 22px;
            border-width: 1px;
            border-color: #6fdd8b55;
            drop-shadow-blur: 48px;
            drop-shadow-color: #000000b0;

            VerticalLayout {
                padding: 38px;
                spacing: 20px;
                alignment: center;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 96px;
                        height: 96px;
                        border-radius: 48px;
                        background: #6fdd8b1f;
                        border-width: 2px;
                        border-color: #6fdd8b;
                        PixelIcon {
                            source: @image-url("../assets/px/reload.svg");
                            colorize: #6fdd8b;
                            width: 48px;
                            height: 48px;
                            x: 24px;
                            y: 24px;
                        }
                    }
                }

                Text {
                    text: "Требуется обновление";
                    font-size: 24px;
                    font-weight: 800;
                    color: #ffffff;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.update-ready
                        ? "Версия \{root.update-version} скачана и готова к установке. Игра недоступна, пока лаунчер не перезапустится."
                        : root.update-status;
                    font-size: 15px;
                    color: #c8c8d4;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                if root.update-ready: HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 260px;
                        height: 52px;
                        border-radius: 13px;
                        background: mandatory-restart-area.has-hover ? #7be89a : #6fdd8b;
                        animate background { duration: 180ms; easing: ease-out-quint; }
                        mandatory-restart-area := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: pointer;
                            clicked => {
                                root.update-restart-requested();
                            }
                        }
                        Text {
                            text: "Перезапустить лаунчер";
                            color: #0c0c12;
                            font-size: 16px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }
            }
        }
    }

    // Полноэкранное уведомление античита (поверх всего интерфейса).
    if root.anticheat-alert != "": Rectangle {
        width: parent.width;
        height: parent.height;
        background: #08080fee;

        // Перехватываем все клики, чтобы интерфейс под оверлеем был недоступен.
        TouchArea {
            width: parent.width;
            height: parent.height;
        }

        Rectangle {
            width: min(parent.width - 80px, 540px);
            height: 380px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: #14141c;
            border-radius: 22px;
            border-width: 1px;
            border-color: #ff5a5a55;
            drop-shadow-blur: 48px;
            drop-shadow-color: #000000b0;

            VerticalLayout {
                padding: 38px;
                spacing: 20px;
                alignment: center;

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 92px;
                        height: 92px;
                        border-radius: 46px;
                        background: #ff5a5a1f;
                        border-width: 2px;
                        border-color: #ff5a5a;
                        Text {
                            text: "!";
                            font-size: 54px;
                            font-weight: 900;
                            color: #ff5a5a;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }

                Text {
                    text: "Запуск заблокирован защитой";
                    font-size: 24px;
                    font-weight: 800;
                    color: #ffffff;
                    horizontal-alignment: center;
                }

                Text {
                    text: root.anticheat-alert;
                    font-size: 15px;
                    color: #c8c8d4;
                    wrap: word-wrap;
                    horizontal-alignment: center;
                }

                HorizontalLayout {
                    alignment: center;
                    Rectangle {
                        width: 220px;
                        height: 52px;
                        border-radius: 13px;
                        background: dismiss-area.has-hover ? #ff6a6a : #e24c4c;
                        animate background { duration: 180ms; easing: ease-out-quint; }
                        dismiss-area := TouchArea {
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: pointer;
                            clicked => {
                                root.anticheat-alert-dismiss();
                            }
                        }
                        Text {
                            text: "Понятно";
                            color: #ffffff;
                            font-size: 16px;
                            font-weight: 700;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            width: parent.width;
                            height: parent.height;
                        }
                    }
                }
            }
        }
    }

    // === Оверлей Политики конфиденциальности (блокирует всё до принятия) ===
    Rectangle {
        x: 0; y: 0;
        width: parent.width; height: parent.height;
        background: #0d0f12;
        visible: root.policy-visible;

        // Глушим клики по подлежащему UI.
        TouchArea {}

        Text {
            x: 48px; y: 32px;
            width: parent.width - 96px;
            text: "Политика конфиденциальности";
            color: #e0e2e5;
            font-size: 24px;
            font-weight: 800;
            overflow: elide;
        }
        Text {
            x: 48px; y: 66px;
            width: parent.width - 96px;
            text: root.policy-version-label;
            color: #8a8f98;
            font-size: 13px;
            overflow: elide;
        }

        Rectangle {
            x: 48px; y: 92px;
            width: parent.width - 96px;
            height: parent.height - 92px - 118px;
            background: #14171c;
            border-radius: 10px;
            clip: true;

            Flickable {
                x: 16px; y: 12px;
                width: parent.width - 32px;
                height: parent.height - 24px;
                viewport-height: policy-body.preferred-height + 24px;

                policy-body := Text {
                    x: 0; y: 0;
                    width: parent.width - 12px;
                    text: root.policy-text;
                    color: #c6cad1;
                    font-size: 14px;
                    wrap: word-wrap;
                }
            }
        }

        Text {
            x: 48px; y: parent.height - 106px;
            width: parent.width - 96px;
            text: "Нажимая «Принять и продолжить», вы подтверждаете согласие с условиями.";
            color: #8a8f98;
            font-size: 12px;
            overflow: elide;
        }

        accept-btn := Rectangle {
            x: 48px; y: parent.height - 76px;
            width: 250px; height: 42px;
            border-radius: 8px;
            // Приглушаем кнопку пока идёт in-flight запрос принятия.
            background: root.policy-accepting ? #8a7a45 : (accept-ta.has-hover ? #d8b45a : #c9a44a);

            Text {
                x: 0; y: 0;
                width: parent.width; height: parent.height;
                text: "Принять и продолжить";
                color: #171310;
                font-size: 15px;
                font-weight: 700;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            accept-ta := TouchArea {
                // Блокируем повторный клик пока запрос ещё выполняется.
                enabled: !root.policy-accepting;
                clicked => { root.policy-accept-requested(); }
            }
        }

        Rectangle {
            x: 48px + 266px; y: parent.height - 76px;
            width: 120px; height: 42px;
            border-radius: 8px;
            border-width: 1px;
            border-color: #3a3f47;

            Text {
                x: 0; y: 0;
                width: parent.width; height: parent.height;
                text: "Выйти";
                color: #c6cad1;
                font-size: 15px;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => { root.logout-requested(); }
            }
        }

        Text {
            x: parent.width - 48px - 220px; y: parent.height - 66px;
            width: 220px;
            text: "Открыть в браузере ↗";
            color: #8fa3c0;
            font-size: 13px;
            horizontal-alignment: right;

            TouchArea {
                clicked => { root.open-url(root.api-url + "/privacy"); }
            }
        }
    }
}
